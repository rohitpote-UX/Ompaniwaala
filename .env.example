# ==============================================================================
# RANJEET ENTERPRISES — Environment Variables Example
# Copy this file to .env.local for local development or configure in Vercel:
# Settings > Environment Variables
# ==============================================================================

# Public Website URL (Canonical base URL for SEO, OpenGraph & Sitemap)
# For local dev: http://localhost:3000
# For Vercel production: https://your-deployment-domain.vercel.app or custom domain
NEXT_PUBLIC_SITE_URL=https://ranjeetenterprises.in

# Contact & Booking Configuration (Aundh, Pune Operational Hub)
# Fill these with verified owner details once provided:

# Formatted phone number for UI display (e.g. "+91 98XXX XXXXX")
NEXT_PUBLIC_CONTACT_PHONE=""

# Raw phone number with country code for tel: links (e.g. "+9198XXXXXXXX")
NEXT_PUBLIC_CONTACT_PHONE_RAW=""

# WhatsApp Business number for instant orders (country code without '+' e.g. "9198XXXXXXXX")
# If left empty, order buttons gracefully route to verified Google Maps Profile
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Business contact & order inquiry email (e.g. "orders@ranjeetenterprises.in")
NEXT_PUBLIC_CONTACT_EMAIL=""

# Customer support email (e.g. "care@ranjeetenterprises.in")
NEXT_PUBLIC_SUPPORT_EMAIL=""
