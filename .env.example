# ==============================================================================
# KALASH | Om Paaniwaala — Environment Variables Example
# Copy this file to .env.local for local development or add these in Vercel:
# Settings > Environment Variables
# ==============================================================================

# Public Website URL (Canonical base URL for SEO, OpenGraph & Sitemap)
# For local dev: http://localhost:3000
# For Vercel production: https://ompaniwaala.vercel.app or your custom domain
NEXT_PUBLIC_SITE_URL=https://kalashwater.in

# Contact & Booking Configuration (Pune Operational Hub)
# Formatted phone number for UI display
NEXT_PUBLIC_CONTACT_PHONE="+91 98220 00000"

# Raw phone number with country code for tel: links (no spaces or hyphens)
NEXT_PUBLIC_CONTACT_PHONE_RAW="+919822000000"

# WhatsApp Business number for instant 1-click orders (country code without '+' sign)
NEXT_PUBLIC_WHATSAPP_NUMBER="919822000000"

# Primary business and order inquiry email
NEXT_PUBLIC_CONTACT_EMAIL="orders@kalashwater.in"

# Customer care and feedback email
NEXT_PUBLIC_SUPPORT_EMAIL="care@kalashwater.in"
